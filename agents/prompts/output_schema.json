{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "model",
    "timestamp",
    "symbol",
    "timeframe",
    "action",
    "volume",
    "confidence",
    "horizon",
    "entry",
    "risk",
    "analysis",
    "context",
    "reason_codes",
    "invalidation",
    "ttl_minutes"
  ],
  "properties": {
    "model": {
      "type": "string",
      "enum": ["gpt", "claude", "gemini", "deepseek"]
    },
    "timestamp": {
      "type": "string",
      "description": "UTC ISO-8601 timestamp"
    },
    "symbol": {
      "type": "string"
    },
    "timeframe": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": ["BUY", "SELL", "HOLD"]
    },
    "volume": {
      "type": "number",
      "minimum": 0.0
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "horizon": {
      "type": "string",
      "enum": ["intra", "swing"]
    },
    "entry": {
      "type": "object",
      "required": ["type", "price"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["market", "limit"]
        },
        "price": {
          "type": ["number", "null"]
        }
      }
    },
    "risk": {
      "type": "object",
      "required": ["stop_loss_pips", "take_profit_pips", "risk_fraction_of_initial"],
      "properties": {
        "stop_loss_pips": {"type": "number", "minimum": 0},
        "take_profit_pips": {"type": "number", "minimum": 0},
        "risk_fraction_of_initial": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "analysis": {
      "type": "object",
      "required": ["basis", "time_horizon", "setup", "sl_tp_rationale"],
      "properties": {
        "basis": {
          "type": "string",
          "enum": ["technical", "fundamental", "mixed"]
        },
        "time_horizon": {
          "type": "string",
          "enum": ["short_term", "long_term"]
        },
        "setup": {"type": "string"},
        "sl_tp_rationale": {"type": "string"}
      }
    },
    "context": {
      "type": "object",
      "required": ["regime", "key_levels"],
      "properties": {
        "regime": {
          "type": "string",
          "enum": ["trending_up", "trending_down", "ranging", "volatile"]
        },
        "key_levels": {
          "type": "object",
          "required": ["support", "resistance"],
          "properties": {
            "support": {"type": "array", "items": {"type": "number"}},
            "resistance": {"type": "array", "items": {"type": "number"}}
          }
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "invalidation": {
      "type": "array",
      "items": {"type": "string"}
    },
    "ttl_minutes": {
      "type": "integer",
      "minimum": 1
    }
  }
}
